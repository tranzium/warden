# --- Service ---
PORT=3004
HOST=127.0.0.1                                 # bind address; only widen this behind a firewall/reverse proxy (see SECURITY.md)
DB_PATH=./data/warden.db
COOKIE_SECRET=                                 # required, min 32 random characters
SESSION_TTL_HOURS=168                          # dashboard session lifetime (sliding), default 7 days

# --- Authentication ---
# local (default): single operator, credentials below, no external dependency.
# orbit: delegate auth + per-user permissions to an Orbit tenant — see docs/orbit-setup.md.
AUTH_MODE=local
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=                            # required in local mode — generate with: bun run scripts/hash-password.ts <password>

# --- Orbit (only read when AUTH_MODE=orbit) ---
ORBIT_INTROSPECT_URL=                          # orbit-introspect base URL (/check endpoint)
ORBIT_API_KEY=                                 # API key for the control-plane tenant
ORBIT_TENANT_ID=                               # control-plane tenant UUID
ORBIT_API_URL=                                 # orbit-service API base URL (for consent auth)
OAUTH_CLIENT_ID=                               # warden OAuth2 client_id
OAUTH_CLIENT_SECRET=                           # leave empty for public client (PKCE-only)
OAUTH_REDIRECT_URI=                            # e.g. https://warden.example.com/callback
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_CONSENT_KEY=                             # private JWK (JSON) for signing consent decisions — only if Warden hosts its own consent screen

# --- NSSM ---
NSSM_PATH=nssm                                # path to nssm.exe (default: on PATH)
WARDEN_SERVICE_NAME=warden                     # NSSM service name for self-status
LOGS_DIR=D:\logs                               # base directory for per-service stdout/stderr logs
