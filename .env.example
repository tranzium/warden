# Orbit integration
ORBIT_INTROSPECT_URL=http://127.0.0.1:3000   # orbit-introspect base URL (/check endpoint)
ORBIT_API_KEY=osk_...                          # API key for the control-plane tenant
ORBIT_TENANT_ID=                               # control-plane tenant UUID
ORBIT_API_URL=http://127.0.0.1:3001            # orbit-service API base URL (for consent auth)

# OAuth2 (for dashboard login flow)
OAUTH_CLIENT_ID=                               # warden OAuth2 client_id
OAUTH_CLIENT_SECRET=                           # leave empty for public client (PKCE-only)
OAUTH_REDIRECT_URI=https://warden.wrift.ca/callback
OAUTH_AUTHORIZE_URL=https://oauth.wrift.ca/oauth2/authorize
OAUTH_TOKEN_URL=https://oauth.wrift.ca/oauth2/token
OAUTH_CONSENT_KEY=                             # private JWK (JSON) for signing consent decisions

# Service
PORT=3004
HOST=0.0.0.0
DB_PATH=./data/warden.db
COOKIE_SECRET=                                 # min 32 random characters

# NSSM
NSSM_PATH=nssm                                # path to nssm.exe (default: on PATH)
WARDEN_SERVICE_NAME=warden                     # NSSM service name for self-status
